---
import { Image } from 'astro:assets';
import logo from '@images/buckleson-logo.jpg';
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const main = basePath;
const docs = `${basePath}welcome-to-docs/`;
---

<span class="site-title">
  <a class="main-logo" href={main} aria-label="Buckleson home">
    <Image src={logo} alt="" width={48} height={48} />
  </a>
  <a class="docs-logo" href={docs} aria-label="Buckleson documentation">
    <span>Buckleson Docs</span>
  </a>
</span>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: 1rem;
  }
  .site-title a {
    display: flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  .main-logo :global(img) {
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    object-fit: contain;
  }
  .docs-logo {
    font-weight: 700;
  }
  .site-title a:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid currentColor;
    outline-offset: 0.2rem;
  }
</style>
