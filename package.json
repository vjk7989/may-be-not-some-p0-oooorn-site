{
  "name": "may-be-not-some-p0-oooorn-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4173",
    "build": "next build",
    "start": "serve out -l 4173",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "design:lint": "designmd lint DESIGN.md",
    "test:unit": "pwsh -NoProfile -File tests/Validate-ProductionWebsite.ps1 -Mode All -SelfTest && vitest run",
    "test:content": "pwsh -NoProfile -File tests/Validate-ProductionWebsite.ps1 -Mode Content",
    "test:links": "pwsh -NoProfile -File tests/Validate-ProductionWebsite.ps1 -Mode Links",
    "test:seo": "pwsh -NoProfile -File tests/Validate-ProductionWebsite.ps1 -Mode Seo",
    "test:404": "pwsh -NoProfile -File tests/Validate-404Performance.ps1",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:a11y": "playwright test --config tests/playwright.config.ts --grep \"usable semantic shell\"",
    "test:performance": "lhci autorun --config tests/lighthouserc.cjs",
    "test": "pwsh -NoProfile -File tests/Validate-ProductionWebsite.ps1 -Mode All && pwsh -NoProfile -File tests/Validate-404Performance.ps1 && vitest run && playwright test --config tests/playwright.config.ts",
    "graft:build": "graft build",
    "graft:check": "graft check",
    "graft:viz": "graft viz"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.5",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "animejs": "4.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@google/design.md": "0.4.0",
    "@lhci/cli": "0.15.1",
    "@nanonets/graft": "0.18.0",
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.5",
    "lighthouse": "12.8.2",
    "playwright-core": "1.55.0",
    "postcss": "8.5.6",
    "serve": "14.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
